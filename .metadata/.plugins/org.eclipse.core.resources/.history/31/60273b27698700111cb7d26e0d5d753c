#include "stm32f4xx_hal.h"
#include "bootloader.h"

#define LED_GREEN_PORT   GPIOD
#define LED_GREEN_PIN    LD4

#define LED_RED_PORT     GPIOD
#define LED_RED_PIN      LD3

#define BTN_PORT         GPIOD
#define BTN_PIN          GPIO_PIN_0
#define RESET_BTN_PIN    GPIO_PIN_1
#define BTN_EXTI_IRQ     EXTI0_IRQn


volatile uint8_t g_bootloaderRequested = 0;  // ISR set = 1
volatile uint8_t g_bootMode = 0;

static void Delay_ms(uint32_t ms)
{
    for (volatile uint32_t i = 0; i < ms * 4000; i++) { __NOP(); }
}

static void LED_Init(void)
{
    __HAL_RCC_GPIOD_CLK_ENABLE();

    GPIO_InitTypeDef gpio = {0};
    gpio.Mode  = GPIO_MODE_OUTPUT_PP;
    gpio.Pull  = GPIO_NOPULL;
    gpio.Speed = GPIO_SPEED_FREQ_LOW;

    gpio.Pin = LED_GREEN_PIN;
    HAL_GPIO_Init(LED_GREEN_PORT, &gpio);

    gpio.Pin = LED_RED_PIN;
    HAL_GPIO_Init(LED_RED_PORT, &gpio);
}


void Bootloader_ButtonEXTI_Init(void)
{
    __HAL_RCC_GPIOD_CLK_ENABLE();

    GPIO_InitTypeDef gpio = {0};
    gpio.Pin  = BTN_PIN;
    gpio.Mode = GPIO_MODE_IT_RISING;
    gpio.Pull = GPIO_NOPULL;
    HAL_GPIO_Init(BTN_PORT, &gpio);

    gpio.Pin  = RESET_BTN_PIN;
    gpio.Mode = GPIO_MODE_IT_RISING;
    gpio.Pull = GPIO_NOPULL;
    HAL_GPIO_Init(BTN_PORT, &gpio);

    HAL_NVIC_SetPriority(EXTI0_IRQn, 0, 0);
    HAL_NVIC_EnableIRQ(EXTI0_IRQn);
}

void Bootloader_ModeExec(uint8_t mode)
{
    if (mode == 1)
    {
        for (int i = 0; i < 6; i++)
        {
            HAL_GPIO_TogglePin(LED_GREEN_PORT, LED_GREEN_PIN);
            Delay_ms(200);
        }
    }
    else if (mode == 2)
    {
        for (int i = 0; i < 6; i++)
        {
            HAL_GPIO_TogglePin(LED_RED_PORT, LED_RED_PIN);
            Delay_ms(200);
        }
    }
}


void HAL_GPIO_EXTI_Callback(uint16_t GPIO_Pin)
{
    if (GPIO_Pin == BTN_PIN)
    {
        Delay_ms(30);
        if (HAL_GPIO_ReadPin(BTN_PORT, BTN_PIN) == GPIO_PIN_RESET)
        {
            g_bootMode = 1;
            g_bootloaderRequested = 1;
        }
    }
    if (GPIO_Pin == RESET_BTN_PIN)
        {
            Delay_ms(30);
            if (HAL_GPIO_ReadPin(BTN_PORT, RESET_BTN_PIN) == GPIO_PIN_RESET)
            {
                NVIC_SystemReset();
            }
        }
}

void Bootloader_PreMain(void)
{
    LED_Init();
    Bootloader_ButtonEXTI_Init();


    uint32_t timeout = 300;
    while (timeout--)
    {
        if (g_bootloaderRequested)
        {
            Bootloader_ModeExec(g_bootMode);
            break;
        }
        Delay_ms(10);
    }
}

__attribute__((constructor))
static void Bootloader_Entry(void)
{
    Bootloader_PreMain();
}
